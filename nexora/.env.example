# Public site URL — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://nexora.example.com

# ---------------------------------------------------------------------------
# Analytics (all optional — each stays off until its ID is present)
# ---------------------------------------------------------------------------
# Plausible: the domain registered in your Plausible account.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Stripe (not wired up yet — see src/lib/payments.ts)
# Payment Links or Checkout Session URLs, one per purchasable product.
# When a value is present the matching CTA becomes a real checkout link;
# when it is absent the CTA falls back to the contact form.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_LINK_WEBSITE_MONTHLY=
NEXT_PUBLIC_STRIPE_LINK_LOGO_ONETIME=
NEXT_PUBLIC_STRIPE_LINK_AUTOMATION_SETUP=
NEXT_PUBLIC_STRIPE_LINK_AUTOMATION_MAINTENANCE=
NEXT_PUBLIC_STRIPE_LINK_APPLICATION_SETUP=
NEXT_PUBLIC_STRIPE_LINK_APPLICATION_MAINTENANCE=

# Server-side Stripe keys (for the future /api/checkout route — never expose).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Lead delivery — the contact form posts to /api/leads.
# Without an endpoint the route logs the lead and returns success.
# ---------------------------------------------------------------------------
LEAD_WEBHOOK_URL=
LEAD_NOTIFICATION_EMAIL=

# ---------------------------------------------------------------------------
# Consultation booking (Cal.com / Calendly / etc). Empty = contact form.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BOOKING_URL=
